const CFG={id:'1Co374l3-B1COWVf-Pt1gDOYN137EQ0ESE2O4thonaY8',firstRow:4,firstCol:9,slots:20};
function db(){return SpreadsheetApp.openById(CFG.id)}
function tab(name){const s=db().getSheetByName(String(name));if(!s)throw Error('Tabellenblatt fehlt: '+name);return s}
function dateKey(d){return Utilities.formatDate(d,db().getSpreadsheetTimeZone(),'yyyy-MM-dd')}
function rowFor(s,iso){if(!/^20\d\d-\d\d-\d\d$/.test(iso))throw Error('Ungültiges Datum');const a=s.getRange(CFG.firstRow,1,Math.max(1,s.getLastRow()-3),1).getValues();const i=a.findIndex(r=>r[0] instanceof Date&&dateKey(r[0])===iso);if(i<0)throw Error('Kein Trainingstermin für '+iso);return i+CFG.firstRow}
function players(){return tab('Spieler').getRange(2,2,CFG.slots,1).getDisplayValues().map((r,i)=>({index:i,name:r[0].trim()})).filter(p=>p.name)}
function years(){return db().getSheets().map(s=>s.getName()).filter(n=>/^20\d{2}$/.test(n)).sort()}
function doGet(){return HtmlService.createHtmlOutputFromFile('Index').setTitle('VolleyTrack').addMetaTag('viewport','width=device-width, initial-scale=1')}
function loadApp(year){const ys=years();const y=ys.includes(String(year))?String(year):ys.includes(String(tab('Einstellungen').getRange('B5').getDisplayValue()))?String(tab('Einstellungen').getRange('B5').getDisplayValue()):ys[0];const s=tab(y);const rows=s.getRange(4,1,Math.max(1,s.getLastRow()-3),8).getValues().filter(r=>r[0] instanceof Date);const dates=rows.map(r=>({date:dateKey(r[0]),holiday:String(r[2]||''),decision:String(r[3]||'Offen')}));return {years:ys,year:y,dates,players:players().length,summary:{planned:rows.filter(r=>!r[2]).length,completed:rows.filter(r=>r[3]==='Durchgeführt').length,canceled:rows.filter(r=>r[3]==='Ausgefallen').length}}}
function loadTraining(year,iso){if(!years().includes(String(year))||!iso.startsWith(String(year)+'-'))throw Error('Ungültiges Jahr');const s=tab(year),r=rowFor(s,iso),v=s.getRange(r,1,1,28).getValues()[0];return {date:iso,decision:String(v[3]||'Offen'),holiday:String(v[2]||''),note:String(v[7]||''),players:players().map(p=>({...p,status:String(v[8+p.index]||'')}))}}
function saveTraining(data){if(!data||!years().includes(String(data.year))||!String(data.date).startsWith(String(data.year)+'-'))throw Error('Ungültiges Datum');if(!['Offen','Durchgeführt','Ausgefallen','Ferien'].includes(data.decision))throw Error('Ungültiger Trainingsstatus');const lock=LockService.getScriptLock();lock.waitLock(20000);try{const s=tab(data.year),r=rowFor(s,data.date);if(s.getRange(r,3).getDisplayValue()&&data.decision!=='Ferien')throw Error('Ferientermin muss als Ferien markiert bleiben');const current=s.getRange(r,9,1,CFG.slots).getValues()[0];const input=new Map((data.players||[]).map(p=>[Number(p.index),String(p.status||'')]));for(const p of players()){if(!input.has(p.index))throw Error('Status fehlt: '+p.name);const status=input.get(p.index);if(!['','Zugesagt','Abgesagt'].includes(status))throw Error('Ungültiger Status');current[p.index]=status} s.getRange(r,9,1,CFG.slots).setValues([current]);s.getRange(r,4).setValue(data.decision);s.getRange(r,8).setValue(String(data.note||'').slice(0,500));return {ok:true}}finally{lock.releaseLock()}}
